---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { topics, type Topic } from "@/data/topics";
import config from "@/config";

export function getStaticPaths() {
  return topics.map(topic => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
const posts = getSortedPosts(await getCollection("posts"))
  .filter(post => post.data.tags.includes(topic.slug));
---

<Layout title={`${topic.title} | ${config.site.title}`}>
  <Header />
  <main id="main-content" class="app-layout py-8">
    <h1 class="text-3xl font-bold">{topic.title}</h1>
    <p class="mt-2">{topic.description}</p>

    {
      posts.length > 0 ? (
        <ul class="mt-6">
          {posts.map(post => <Card {...post} />)}
        </ul>
      ) : (
        <p class="mt-8">No published articles yet.</p>
      )
    }
  </main>
  <Footer />
</Layout>
